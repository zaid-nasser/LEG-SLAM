# Blackwell (SM 120) build.
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04
ENV TORCH_CUDA_ARCH_LIST="12.0"
ARG BUILD_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=12.0 \
    CUDAARCHS=120 \
    MAX_JOBS=${BUILD_JOBS} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} \
    OPENCV_VERSION=4.12.0 \
    TORCH_VERSION=2.7.1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10
ENV PATH=/usr/local/cuda/bin:${PATH}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git wget unzip pkg-config ca-certificates curl \
    libeigen3-dev libboost-all-dev libjsoncpp-dev libopengl-dev mesa-utils \
    libglfw3-dev libglm-dev libssl-dev libffi-dev python3 python3-pip \
    libgtk2.0-dev libavcodec-dev libavformat-dev libswscale-dev libv4l-dev \
    libxvidcore-dev libx264-dev libjpeg-dev libpng-dev libtiff-dev \
    libatlas-base-dev gfortran libtbb-dev libdc1394-dev libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Native CUDA-enabled C++ OpenCV. Python cv2 remains the pip package.
RUN mkdir -p /workspace/opencv-build && cd /workspace/opencv-build && \
    curl -fL --retry 8 --retry-all-errors https://codeload.github.com/opencv/opencv_contrib/tar.gz/refs/tags/${OPENCV_VERSION} -o contrib.tgz && \
    curl -fL --retry 8 --retry-all-errors https://codeload.github.com/opencv/opencv/tar.gz/refs/tags/${OPENCV_VERSION} -o opencv.tgz && \
    tar -xzf opencv.tgz && tar -xzf contrib.tgz && \
    cmake -S opencv-${OPENCV_VERSION} -B build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local/opencv \
      -DWITH_CUDA=ON -DCUDA_ARCH_BIN=12.0 -DCUDA_ARCH_PTX= \
      -DWITH_CUDNN=OFF -DOPENCV_DNN_CUDA=OFF \
      -DWITH_NVCUVID=OFF -DWITH_NVCUVENC=OFF \
      -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda \
      -DOPENCV_EXTRA_MODULES_PATH=/workspace/opencv-build/opencv_contrib-${OPENCV_VERSION}/modules \
      -DBUILD_TIFF=ON -DBUILD_ZLIB=ON -DBUILD_JASPER=ON -DBUILD_CCALIB=ON -DBUILD_JPEG=ON \
      -DWITH_FFMPEG=ON -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF \
      -DBUILD_EXAMPLES=OFF -DBUILD_opencv_python3=OFF && \
    cmake --build build --parallel ${BUILD_JOBS} && cmake --install build && \
    cd /workspace && rm -rf /workspace/opencv-build

# Isolate Python dependencies from the system Python.
RUN apt-get update && apt-get install -y --no-install-recommends python3-dev python3-venv && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:${PATH}


RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade \
      pip setuptools==75.8.2 wheel

RUN --mount=type=cache,target=/root/.cache/pip \
    for attempt in 1 2 3 4 5; do \
      python -m pip install \
        torch==${TORCH_VERSION} \
        torchvision==0.22.1 \
        torchaudio==2.7.1 \
        --index-url https://download.pytorch.org/whl/cu128 \
      && exit 0; \
      echo "PyTorch installation attempt ${attempt} failed."; \
      sleep 10; \
    done; \
    exit 1

COPY requirements.blackwell.txt /workspace/requirements.blackwell.txt
# Prevent a dependency from silently replacing the CUDA-enabled PyTorch build.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip freeze | grep -E '^(torch|torchvision|torchaudio|triton|sympy)==' > /tmp/torch-constraints.txt && \
    python -m pip install \
      -c /tmp/torch-constraints.txt \
      -r /workspace/requirements.blackwell.txt && \
    python -m pip check && \
    python -c 'import torch; assert torch.version.cuda == "12.8"; print(torch.__version__, torch.version.cuda)'


RUN ln -s "$(python -c 'import pathlib,torch; print(pathlib.Path(torch.__file__).parent)')" /workspace/libtorch && \
    test -f /workspace/libtorch/share/cmake/Torch/TorchConfig.cmake

COPY eval/submodules/ /workspace/pip-submodules/
RUN python -m pip install --no-cache-dir --no-build-isolation --no-deps /workspace/pip-submodules/diff-gaussian-rasterization-legs-slam/

RUN python -m pip install --no-cache-dir --no-build-isolation --no-deps /workspace/pip-submodules/simple-knn/

ENV OpenCV_DIR=/usr/local/opencv/lib/cmake/opencv4 \
    Torch_DIR=/workspace/libtorch/share/cmake/Torch \
    CMAKE_PREFIX_PATH=/workspace/libtorch:/usr/local/opencv
ENV LD_LIBRARY_PATH=/workspace/libtorch/lib:/usr/local/opencv/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

COPY ORB-SLAM3/ /workspace/ORB-SLAM3/
RUN cd /workspace/ORB-SLAM3/Thirdparty/DBoW2 && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DOpenCV_DIR=${OpenCV_DIR} && \
    cmake --build build --parallel ${BUILD_JOBS}
RUN cd /workspace/ORB-SLAM3/Thirdparty/g2o && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel ${BUILD_JOBS}
RUN cd /workspace/ORB-SLAM3/Thirdparty/Sophus && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel ${BUILD_JOBS}
RUN cd /workspace/ORB-SLAM3 && tar -xf Vocabulary/ORBvoc.txt.tar.gz -C Vocabulary && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DOpenCV_DIR=${OpenCV_DIR} && \
    cmake --build build --parallel ${BUILD_JOBS}

COPY CMakeLists.txt /workspace/
COPY include/ /workspace/include/
COPY viewer/ /workspace/viewer/
COPY cuda_rasterizer/ /workspace/cuda_rasterizer/
COPY third_party/ /workspace/third_party/
COPY examples/ /workspace/examples/
COPY tools/ /workspace/tools/
COPY encoder_models/ /workspace/encoder_models/
COPY cfg/ /workspace/cfg/
COPY src/ /workspace/src/
COPY eval/ /workspace/eval/

RUN cmake -S /workspace -B /workspace/build -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=120 -DOpenCV_DIR=${OpenCV_DIR} -DTorch_DIR=${Torch_DIR} && \
    cmake --build /workspace/build --parallel ${BUILD_JOBS}

RUN printf '%s\n' '#!/bin/bash' 'cd /workspace' 'exec ./bin/legs_slam_rgbd "$@"' > /workspace/run_legs_slam.sh && \
    chmod +x /workspace/run_legs_slam.sh
RUN mkdir -p /root/.cache/torch/hub/checkpoints
CMD ["/bin/bash"]
